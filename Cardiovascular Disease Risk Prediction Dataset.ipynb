# 2. DATA PREPROCESSING

# Separate predictors and target variable
X = cardio_data.drop(columns=["cardiovascular_risk"])
y = cardio_data["cardiovascular_risk"]

# Divide the data into 80% training and 20% testing
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training set:", X_train.shape)
print("Testing set:", X_test.shape)


# 3. CREATE THE MACHINE-LEARNING MODELS

# Decision Tree pipeline
dt_pipe = make_pipeline(
    StandardScaler(),
    DecisionTreeClassifier(random_state=42)
)

# K-Nearest Neighbors pipeline
knn_pipe = make_pipeline(
    StandardScaler(),
    KNeighborsClassifier()
)

# Random Forest model
rf_model = RandomForestClassifier(random_state=42)


# 4. HYPERPARAMETER TUNING

# Decision Tree parameters
dt_param_grid = {
    "decisiontreeclassifier__max_depth": [3, 5, 7, 9],
    "decisiontreeclassifier__min_samples_split": [2, 5, 10]
}

dt_grid = GridSearchCV(
    estimator=dt_pipe,
    param_grid=dt_param_grid,
    cv=5,
    scoring="accuracy",
    n_jobs=-1
)

dt_grid.fit(X_train, y_train)


# K-Nearest Neighbors parameters
knn_param_grid = {
    "kneighborsclassifier__n_neighbors": [3, 5, 7, 9, 11]
}

knn_grid = GridSearchCV(
    estimator=knn_pipe,
    param_grid=knn_param_grid,
    cv=5,
    scoring="accuracy",
    n_jobs=-1
)

knn_grid.fit(X_train, y_train)


# Random Forest parameters
rf_param_grid = {
    "n_estimators": [50, 100, 200],
    "max_depth": [5, 10, 15]
}

rf_grid = GridSearchCV(
    estimator=rf_model,
    param_grid=rf_param_grid,
    cv=5,
    scoring="accuracy",
    n_jobs=-1
)

rf_grid.fit(X_train, y_train)


# 5. MODEL EVALUATION

models = {
    "Decision Tree": dt_grid,
    "K-Nearest Neighbors": knn_grid,
    "Random Forest": rf_grid
}

model_results = {}

for model_name, grid_model in models.items():

    # Make predictions
    predictions = grid_model.best_estimator_.predict(X_test)

    # Obtain evaluation results
    report = classification_report(
        y_test,
        predictions,
        output_dict=True,
        zero_division=0
    )

    # Store the results
    model_results[model_name] = {
        "accuracy": report["accuracy"],
        "precision": report["1"]["precision"],
        "recall": report["1"]["recall"],
        "f1_score": report["1"]["f1-score"]
    }

    print(f"\n--- {model_name} Classifier ---")
    print("Best hyperparameters:", grid_model.best_params_)

    print(
        "\nClassification Report:\n",
        classification_report(
            y_test,
            predictions,
            target_names=["Low Risk", "High Risk"],
            zero_division=0
        )
    )

    print(
        "Confusion Matrix:\n",
        confusion_matrix(y_test, predictions)
    )


# Create a model-comparison table
results_df = pd.DataFrame(model_results).T

results_df = results_df.sort_values(
    by="accuracy",
    ascending=False
)

print("\n--- Model Comparison ---")
display(results_df.round(3))


# 6. CONCLUSION

# Select the model with the highest test accuracy
best_model = results_df.index[0]
best_accuracy = results_df.iloc[0]["accuracy"]
best_precision = results_df.iloc[0]["precision"]
best_recall = results_df.iloc[0]["recall"]
best_f1 = results_df.iloc[0]["f1_score"]

print("\n--- Conclusion ---")

print(
    f"The {best_model} classifier performed best on the test dataset."
)

print(
    f"It achieved {best_accuracy:.2%} accuracy, "
    f"{best_precision:.2%} precision, "
    f"{best_recall:.2%} recall, and "
    f"{best_f1:.2%} F1-score for the high-risk group."
)

print(
    "Based on these results, it is the strongest of the three "
    "models for predicting cardiovascular disease risk in this dataset."
)
